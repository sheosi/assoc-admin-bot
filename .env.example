# Assoc Admin Bot RS - Environment Configuration
# Copy this file to .env and fill in your values

# Telegram Bot (required)
TELEGRAM_TOKEN=your_telegram_bot_token_here
DEFAULT_ADMIN=your_telegram_username_without_@

# OpenAI API (required)
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-4

# Database (optional, defaults to /data)
DATA_PATH=/data

# Server Port (optional, defaults to 8079)
PORT=8079

# SMTP Email Configuration (required for email features)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-specific-password
FROM_ADDRESS=<your-email@gmail.com>

# Infisical Secrets Management (optional)
# If configured, these secrets will be loaded and can override env vars
INFISICAL_CLIENT_ID=your-infisical-client-id
INFISICAL_CLIENT_SECRET=your-infisical-client-secret
INFISICAL_PROJECT_ID=your-project-id
INFISICAL_ENVIRONMENT=dev
INFISICAL_API_URL=https://app.infisical.com

# Ruralvia Bank Payment Checker (optional)
# If set, the bot will check for new payments every 10 minutes
RURALVIA_USER=your-dni-or-nie
RURALVIA_PASS=your-ruralvia-password

# Google Calendar Integration (optional)
# Path to service account JSON credentials file (relative to DATA_PATH)
GOOGLE_CALENDAR_CREDENTIALS=google_credentials.json
